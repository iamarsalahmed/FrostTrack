# From Neon Console > Connect: Pooled PostgreSQL connection URL.
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Random 32+ character HMAC signing secret for manager login cookies.
SESSION_SECRET=replace-with-very-long-random-secret-at-least-32-chars
# Independent 20+ character key for the Arduino gateway / telemetry API.
DEVICE_API_KEY=replace-with-strong-random-device-key
# No MANAGER_PASSWORD environment variable: manager credentials are in the managers table.
