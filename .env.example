# From Neon dashboard > Connect (PostgreSQL pooled connection string)
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Set a strong password for dashboard login (not used as a public browser variable)
MANAGER_PASSWORD=replace-with-long-unique-password
# Random string at least 32 characters; used to sign session cookies
SESSION_SECRET=replace-with-very-long-random-secret-at-least-32-chars
# Unique device key, used ONLY by Arduino LAN gateway; never expose to browser
DEVICE_API_KEY=replace-with-strong-random-device-key
